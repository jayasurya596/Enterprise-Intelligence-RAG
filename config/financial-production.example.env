# Target profile only. Inject real secrets through the selected cloud secret manager.
# Do not deploy with the placeholders below.
APP_IMAGE=registry.example.invalid/enterprise-rag-api:replace-with-immutable-tag
WEB_IMAGE=registry.example.invalid/enterprise-rag-web:replace-with-immutable-tag
PUBLIC_API_URL=https://api.example.com
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres.example.com:5432/enterprise_rag?sslmode=require
QDRANT_URL=https://qdrant.example.com
QDRANT_API_KEY=replace-with-cloud-secret
ALLOWED_ORIGINS=https://app.example.com
CLOUD_INGRESS_NETWORK=replace-with-existing-ingress-network
UPLOAD_VOLUME=replace-with-existing-durable-encrypted-volume
DEFAULT_DOMAIN=financial
MAX_UPLOAD_MB=25
CHUNK_SIZE_CHARS=3200
CHUNK_OVERLAP_CHARS=480
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-v1
EMBEDDING_DIMENSIONS=384
MIN_DENSE_SCORE=0.2
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-base
GENERATION_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TOP_K_DENSE=20
TOP_K_BM25=20
TOP_K_RERANK=8
RRF_K=60
ACCESS_TOKEN_MINUTES=45
